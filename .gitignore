# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Jekyll build caches
.jekyll-cache/
.jekyll-metadata

# Safety net: raw inputs must never be committed (they live in ../website-inputs/)
website-inputs/
*.docx
*.bib.bak

# Large/raw media: commit only web-optimized versions (photo <300 KB, PDFs <10 MB)
*.psd
*.tif
*.tiff
*.heic
*.mov
*.mp4
